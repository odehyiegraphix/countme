# Root-level gitignore for CountMe

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Backend (Laravel)
backend/.env
backend/vendor/
backend/storage/*.key
backend/storage/pail/
backend/public/storage
backend/public/hot
backend/public/build
backend/node_modules/

# Frontend (React/Vite)
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local

# Logs
*.log
